# Copy to .env (or export directly). All settings are OPTIONAL —
# with no keys, the app runs in rules-only mode.

# Which GenAI provider polishes responses: gemini | anthropic | none
# Leave unset to auto-detect from whichever key below is present
# (Gemini wins if both are set).
LLM_PROVIDER=

# Google (Gemini) — free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
